NUXT_DATABASE_URL=postgresql://tourenplan:tourenplan_dev@127.0.0.1:5432/tourenplan

# Required in production (no fallback in nuxt.config)
NUXT_JWT_SECRET=change-me-in-production-min-32-chars
NUXT_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me

NUXT_BOOTSTRAP_ADMIN_EMAIL=admin@localhost.local
NUXT_ORS_API_KEY=your-openrouteservice-api-key

POSTGRES_USER=tourenplan
POSTGRES_PASSWORD=tourenplan_dev
POSTGRES_DB=tourenplan

# Production (docker-compose.prod.yml)
DOMAIN=tourenplan.example.com
